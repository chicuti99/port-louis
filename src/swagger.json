{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Grupos e Contatos",
    "version": "1.0.0",
    "description": "API para gerenciamento de contatos e grupos, com funcionalidades como criar, atualizar, listar e excluir registros, além de relatórios."
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Servidor de desenvolvimento"
    }
  ],
  "paths": {
    "/contatos": {
      "post": {
        "summary": "Criar um novo contato",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "João da Silva" },
                  "telefone": { "type": "string", "example": "(11) 91234-5678" }
                },
                "required": ["nome", "telefone"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contato criado com sucesso."
          },
          "400": {
            "description": "Erro de validação ou duplicidade de telefone."
          }
        }
      },
      "get": {
        "summary": "Listar contatos",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "Número da página."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 10
            },
            "description": "Quantidade de itens por página."
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contatos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "nome": { "type": "string", "example": "João da Silva" },
                      "telefone": { "type": "string", "example": "(11) 91234-5678" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contatos/{id}": {
      "patch": {
        "summary": "Atualizar um contato existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "ID do contato a ser atualizado."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Maria Oliveira" },
                  "telefone": { "type": "string", "example": "(21) 92345-6789" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contato atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "nome": { "type": "string", "example": "Maria Oliveira" },
                    "telefone": { "type": "string", "example": "(21) 92345-6789" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contato não encontrado."
          }
        }
      },
      "delete": {
        "summary": "Excluir um contato",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "ID do contato a ser excluído."
          }
        ],
        "responses": {
          "204": {
            "description": "Contato excluído com sucesso."
          },
          "404": {
            "description": "Contato não encontrado."
          }
        }
      }
    },
    "/grupos": {
      "post": {
        "summary": "Criar um novo grupo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Clientes" }
                },
                "required": ["nome"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Grupo criado com sucesso."
          },
          "400": {
            "description": "Erro de validação ou grupo já existe."
          }
        }
      }
    },
    "/grupos/{id}": {
      "patch": {
        "summary": "Atualizar um grupo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "ID do grupo a ser atualizado."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Fornecedores" }
                },
                "required": ["nome"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grupo atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "nome": { "type": "string", "example": "Fornecedores" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Grupo não encontrado."
          }
        }
      }
    },
    "/relatorio/contatos-grupos": {
      "get": {
        "summary": "Relatório de contatos por grupo",
        "responses": {
          "200": {
            "description": "Relatório gerado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "grupo": { "type": "string", "example": "Clientes" },
                      "quantidade_contatos": { "type": "integer", "example": 25 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
